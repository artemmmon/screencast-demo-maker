{
  "slug": "myapp-intro",
  "projectRoot": "/absolute/path/to/project",
  "output": "demo/intro/myapp-intro.mp4",
  "order": ["s1", "s2", "s3"],
  "surfaces": ["browser", "editor", "terminal"],
  "healthUrls": ["http://localhost:3000"],
  "video": { "fps": 30, "zoom": 1.25, "display": "1920x1080" },
  "tts": {
    "provider": "elevenlabs",
    "voiceId": "",
    "voiceName": "",
    "language": "en",
    "model": "eleven_multilingual_v2",
    "keychainService": "elevenlabs-api",
    "charsPerSecond": 14
  },
  "vscode": {
    "firstFile": "README.md",
    "hide": ["**/node_modules", "dist"]
  },
  "terminal": { "fontSize": 14 },
  "web": { "baseUrl": "http://localhost:3000" },
  "neverClick": ["Delete", "Deploy"]
}
